{
  "nodes": [
    {"id":"root","type":"text","x":0,"y":0,"width":260,"height":80,"text":"# Thinking, Fast and Slow 📖\nDaniel Kahneman — core summary"},
    {"id":"s1","type":"text","x":320,"y":-200,"width":240,"height":70,"text":"Part 1: Two Systems 系统一与系统二"},
    {"id":"s1a","type":"text","x":620,"y":-260,"width":240,"height":90,"text":"System 1: fast, automatic, emotional. Runs the show more than we think, and is the secret author of many choices."},
    {"id":"s1b","type":"text","x":620,"y":-150,"width":240,"height":70,"text":"System 2: slow, deliberate, effortful ⚙️"},
    {"id":"s1b1","type":"text","x":900,"y":-150,"width":220,"height":70,"text":"Lazy controller 懶惰的控制者"},
    {"id":"s1b1a","type":"text","x":1160,"y":-150,"width":220,"height":70,"text":"Ego depletion"},
    {"id":"s1b1a1","type":"text","x":1420,"y":-150,"width":220,"height":70,"text":"Glucose & self-control experiments"},
    {"id":"s1b1a1a","type":"text","x":1680,"y":-150,"width":220,"height":80,"text":"判断疲劳 (judgment fatigue): parole boards rule more harshly before lunch"},
    {"id":"s2","type":"text","x":320,"y":0,"width":240,"height":70,"text":"Part 2: Heuristics & Biases"},
    {"id":"s2a","type":"text","x":620,"y":-40,"width":240,"height":70,"text":"Anchoring ⚓ アンカリング効果"},
    {"id":"s2b","type":"text","x":620,"y":60,"width":240,"height":70,"text":"Availability heuristic"},
    {"id":"s3","type":"text","x":320,"y":200,"width":240,"height":70,"text":"Part 3: Overconfidence"},
    {"id":"s3a","type":"text","x":620,"y":200,"width":240,"height":90,"text":"The illusion of validity — we build coherent stories from little data and trust them far too much."},
    {"id":"empty1","type":"text","x":620,"y":320,"width":180,"height":50,"text":"   "},
    {"id":"s4","type":"text","x":320,"y":420,"width":240,"height":70,"text":"Part 4: Choices 選擇"},
    {"id":"s4a","type":"text","x":620,"y":420,"width":240,"height":70,"text":"Prospect theory 損失回避"}
  ],
