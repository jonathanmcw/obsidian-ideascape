{
  "name": "obsidian-ideascape",
  "version": "1.0.0",
  "description": "Mind maps you type, not draw. Tab adds a child, Enter a sibling, and your hands stay on the keyboard. One shortcut turns the map into an outline. Plain Markdown underneath, yours to keep.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/build-css.mjs",
    "check": "npm run lint && npm test && npm run build && npm run ui && npm run verify:export && npm run verify:release",
    "dev": "node scripts/build-css.mjs && node esbuild.config.mjs",
    "css": "node scripts/build-css.mjs",
    "test": "node --test test/*.test.ts",
    "lint": "eslint src manifest.json package.json --max-warnings 0",
    "verify:export": "node scripts/export-check.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "showcase": "bash scripts/shots/showcase.sh",
    "install:vault": "node scripts/install.mjs",
    "welcome:again": "node scripts/welcome-again.mjs",
    "fresh:start": "node scripts/fresh-start.mjs",
    "ui": "node scripts/ui-check.mjs",
    "review": "node scripts/shots/review.mjs",
    "phone": "node scripts/shots/phone.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "playwright": "^1.63.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
